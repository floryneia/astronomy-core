{
  "name": "astronomy-core",
  "version": "0.1.0",
  "description": "Provider-pattern TypeScript library for precise celestial position calculations — planets, asteroids, lunar nodes, Placidus houses, astrocartography coordinates",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "astronomy",
    "astrology",
    "celestial",
    "ephemeris",
    "planets",
    "typescript",
    "placidus",
    "astrocartography"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/floryneia/astronomy-core.git"
  },
  "homepage": "https://github.com/floryneia/astronomy-core#readme",
  "dependencies": {
    "astronomy-engine": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
